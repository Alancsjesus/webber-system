# === Django Core ===
SECRET_KEY=your-secret-key-change-in-production-12345
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# === Banco de dados ===
# Docker (docker compose up): USE_POSTGRES=True, DB_HOST=db  [padrão abaixo]
# Local sem Docker:           USE_POSTGRES=False              [SQLite, sem PG]
USE_POSTGRES=True
DB_NAME=webber_db
DB_USER=webber_user
DB_PASSWORD=webber_pass
DB_HOST=db
DB_PORT=5432

# === Redis ===
# Docker: redis://redis:6379/0
# Local:  redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0

# === CORS ===
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
