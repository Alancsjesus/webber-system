# === Django Core ===
SECRET_KEY=your-secret-key-change-in-production-12345
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# === Banco de dados ===
# Use USE_POSTGRES=False para SQLite (padrão, sem necessidade de Docker)
# Use USE_POSTGRES=True para PostgreSQL (requer Docker ou servidor PG local)
USE_POSTGRES=False

DB_NAME=webber_db
DB_USER=webber_user
DB_PASSWORD=webber_pass
DB_HOST=localhost
DB_PORT=5432

# === Redis (cache/sessões — necessário ao usar PostgreSQL) ===
REDIS_URL=redis://localhost:6379/0
