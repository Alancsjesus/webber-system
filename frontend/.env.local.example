# Copie este arquivo para .env.local e ajuste conforme seu ambiente local.
# O arquivo .env.local NÃO é versionado (está no .gitignore).
#
# Padrões assumidos pelo vite.config.js quando as variáveis não existem:
#   VITE_API_TARGET = http://localhost:8000   (backend Django padrão)
#   VITE_HOST       = false                   (apenas localhost)
#
# Exemplos de sobrescrita:

# Backend rodando em porta diferente (ex: conflito de porta no Docker)
# VITE_API_TARGET=http://localhost:9000

# Expor o dev-server em todas as interfaces de rede (Docker, acesso por outro dispositivo na LAN)
# VITE_HOST=true
